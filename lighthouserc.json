{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/models/snort-1/index.html",
        "http://localhost/safety/index.html",
        "http://localhost/team/index.html",
        "http://localhost/careers/index.html",
        "http://localhost/careers/apply/index.html",
        "http://localhost/news/series-z/index.html",
        "http://localhost/waitlist/index.html",
        "http://localhost/research/index.html",
        "http://localhost/playground/index.html",
        "http://localhost/status/index.html",
        "http://localhost/legal/terms/index.html",
        "http://localhost/legal/privacy/index.html",
        "http://localhost/legal/responsible-scaling-policy/index.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
