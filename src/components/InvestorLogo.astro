---
// Invented investor wordmarks: a simple glyph plus the firm name, drawn in
// currentColor so they follow the theme. Names are fictional.
export type Investor = 'kibble' | 'lapdog' | 'sunbeam' | 'squeak' | 'brunch';

interface Props {
  firm: Investor;
  class?: string;
}

const { firm, class: className } = Astro.props;

const names: Record<Investor, string> = {
  kibble: 'Kibble Capital',
  lapdog: 'Lapdog Ventures',
  sunbeam: 'Sunbeam Sovereign Fund',
  squeak: 'Squeak & Partners',
  brunch: 'Late Brunch Partners',
};
const name = names[firm];
// textLength pins the wordmark width so a fallback font can't overflow the viewBox.
const textLength = { kibble: 118, lapdog: 126, sunbeam: 168, squeak: 124, brunch: 148 }[firm];
const W = 40 + textLength;
---

<svg
  viewBox={`0 0 ${W} 36`}
  class={className}
  role="img"
  aria-label={name}
  xmlns="http://www.w3.org/2000/svg"
  focusable="false"
>
  <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    {
      firm === 'kibble' && (
        <>
          <circle cx="16" cy="18" r="6" />
          <circle cx="10" cy="12" r="3" />
          <circle cx="22" cy="24" r="3" />
        </>
      )
    }
    {firm === 'lapdog' && <path d="M5 28 L16 7 L27 28 Z" />}
    {
      firm === 'sunbeam' && (
        <>
          <circle cx="16" cy="18" r="5" />
          <path d="M16 5v4M16 27v4M3 18h4M25 18h4M7 9l3 3M22 24l3 3M7 27l3-3M22 12l3-3" />
        </>
      )
    }
    {
      firm === 'squeak' && (
        <>
          <rect x="5" y="7" width="22" height="22" rx="7" />
          <path d="M12 18h8" />
        </>
      )
    }
    {
      firm === 'brunch' && (
        <>
          <path d="M5 20a11 11 0 0 1 22 0Z" />
          <path d="M5 26h22" />
        </>
      )
    }
  </g>
  <text
    x="38"
    y="24"
    fill="currentColor"
    font-family="var(--font-serif)"
    font-size="17"
    font-weight="600"
    textLength={textLength}
    lengthAdjust="spacingAndGlyphs">{name}</text
  >
</svg>
