---
// Light/dark switch. The header renders it twice (inline on desktop, inside the menu below lg),
// and the script in Base.astro wires up every [data-theme-toggle] and keeps aria-pressed in sync.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="true"
  aria-label="Dark mode"
  class:list={[
    'border-rule text-muted hover:text-ink h-9 w-9 items-center justify-center rounded border',
    className,
  ]}
>
  <svg
    viewBox="0 0 24 24"
    class="hidden h-5 w-5 dark:block"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg
    viewBox="0 0 24 24"
    class="block h-5 w-5 dark:hidden"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>
