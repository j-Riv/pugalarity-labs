---
// Log-x line chart, drawn as SVG at build time (no chart library, no client JS).
// The x axis is logarithmic, which is why points are placed with Math.log10.
interface Point {
  x: number;
  y: number;
}

interface Props {
  title: string;
  /** One-sentence description for screen readers. */
  desc: string;
  xLabel: string;
  yLabel: string;
  points: Point[];
  /** Optional callout attached to the point whose x matches. */
  annotation?: { x: number; text: string };
  /** Y axis ticks to draw. */
  yTicks: number[];
  /** X axis ticks to draw (powers of ten work best). */
  xTicks: number[];
}

const { title, desc, xLabel, yLabel, points, annotation, yTicks, xTicks } = Astro.props;

const W = 480;
const H = 320;
const pad = { l: 52, r: 20, t: 20, b: 52 };
const innerW = W - pad.l - pad.r;
const innerH = H - pad.t - pad.b;

const xMin = Math.log10(xTicks[0]);
const xMax = Math.log10(xTicks[xTicks.length - 1]);
const yMin = Math.min(...yTicks);
const yMax = Math.max(...yTicks);

const sx = (x: number) => pad.l + ((Math.log10(x) - xMin) / (xMax - xMin)) * innerW;
const sy = (y: number) => pad.t + (1 - (y - yMin) / (yMax - yMin)) * innerH;

const path = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${sx(p.x).toFixed(1)} ${sy(p.y).toFixed(1)}`).join(' ');
const mark = annotation ? points.find((p) => p.x === annotation.x) : undefined;
// Keep the callout inside the plot: flip it to the left of the point if it would overflow.
const flip = mark ? sx(mark.x) > W * 0.6 : false;

const fmtX = (n: number) => (n >= 1000 ? `${n / 1000}k` : String(n));
---

<figure class="border-rule bg-paper-2 rounded-lg border p-5">
  <figcaption class="font-serif text-lg font-semibold">{title}</figcaption>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-labelledby="lc-title lc-desc"
    class="mt-3 h-auto w-full"
    xmlns="http://www.w3.org/2000/svg"
    focusable="false"
  >
    <title id="lc-title">{title}</title>
    <desc id="lc-desc">{desc}</desc>

    <g stroke="var(--rule)" stroke-width="1">
      {yTicks.map((t) => <line x1={pad.l} x2={W - pad.r} y1={sy(t)} y2={sy(t)} />)}
    </g>
    <g fill="var(--muted)" font-size="13" font-family="var(--font-mono)">
      {
        yTicks.map((t) => (
          <text x={pad.l - 8} y={sy(t) + 4} text-anchor="end">
            {t}
          </text>
        ))
      }
      {
        xTicks.map((t) => (
          <text x={sx(t)} y={H - pad.b + 20} text-anchor="middle">
            {fmtX(t)}
          </text>
        ))
      }
    </g>
    <text x={pad.l + innerW / 2} y={H - 8} text-anchor="middle" font-size="13" fill="var(--muted)">{xLabel}</text>
    <text
      transform={`translate(14 ${pad.t + innerH / 2}) rotate(-90)`}
      text-anchor="middle"
      font-size="13"
      fill="var(--muted)">{yLabel}</text
    >

    <path d={path} fill="none" stroke="var(--accent)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"></path>
    {points.map((p) => <circle cx={sx(p.x)} cy={sy(p.y)} r="3.5" fill="var(--accent)" />)}

    {
      mark && annotation && (
        <g>
          <circle cx={sx(mark.x)} cy={sy(mark.y)} r="8" fill="none" stroke="var(--ink)" stroke-width="2" />
          <text
            x={sx(mark.x) + (flip ? -14 : 14)}
            y={sy(mark.y) - 14}
            text-anchor={flip ? 'end' : 'start'}
            font-size="13"
            font-weight="600"
            fill="var(--ink)"
          >
            {annotation.text}
          </text>
        </g>
      )
    }
  </svg>
</figure>
