---
// Non-modal notice at the bottom of the page. Hidden until the script shows it,
// so it never appears (or blocks anything) without JavaScript. Both buttons
// dismiss it; the choice lasts for the tab session only and is never sent anywhere.
---

<section
  data-cookie-banner
  hidden
  aria-label="Cookie notice"
  class="border-rule bg-paper-2 fixed inset-x-4 bottom-4 z-40 mx-auto max-w-2xl rounded-lg border p-5 shadow-lg"
>
  <p class="font-medium">We use cookies. We have already eaten them.</p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button
      type="button"
      data-cookie-accept
      class="bg-accent text-paper rounded px-4 py-2 font-medium hover:opacity-90"
    >
      Accept all cookies
    </button>
    <button
      type="button"
      data-cookie-accept
      class="border-ink rounded border px-4 py-2 font-medium hover:opacity-80"
    >
      Accept all cookies (enthusiastically)
    </button>
  </div>
</section>

<script>
  const KEY = 'cookie-notice-dismissed';
  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

  // Storage can throw (private windows, blocked site data), so every access is guarded.
  const wasDismissed = () => {
    try {
      return sessionStorage.getItem(KEY) === '1';
    } catch {
      return false;
    }
  };

  if (banner && !wasDismissed()) {
    banner.hidden = false;
    banner.querySelectorAll('[data-cookie-accept]').forEach((button) => {
      button.addEventListener('click', () => {
        banner.hidden = true;
        try {
          sessionStorage.setItem(KEY, '1');
        } catch {
          // Nothing to do: the banner simply returns next page.
        }
        // The focused button just disappeared; hand focus to the page content.
        document.getElementById('main')?.focus();
      });
    });
  }
</script>
