---
// Nothing here collects anything. The fields have no `name` attribute, so even if
// JavaScript never runs, the browser submits no data. The script below only
// preselects the role from ?role= and swaps the form for a confirmation message.
import { roles } from '../data/roles';

const field = 'border-rule bg-paper placeholder:text-muted w-full min-w-0 rounded border px-4 py-3';
---

<div data-apply>
  <form data-apply-form class="max-w-xl space-y-6">
    <div>
      <label for="apply-name" class="block font-medium">Full name</label>
      <input id="apply-name" type="text" required autocomplete="name" class:list={['mt-2', field]} />
    </div>
    <div>
      <label for="apply-email" class="block font-medium">Email address</label>
      <input
        id="apply-email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class:list={['mt-2', field]}
      />
    </div>
    <div>
      <label for="apply-role" class="block font-medium">Role</label>
      <select id="apply-role" class:list={['mt-2', field]}>
        {roles.map((r) => <option value={r.id}>{r.title}</option>)}
      </select>
    </div>
    <div>
      <label for="apply-why" class="block font-medium">Why do you want to work here?</label>
      <textarea id="apply-why" rows="5" class:list={['mt-2', field]}></textarea>
    </div>
    <div class="flex items-start gap-3">
      <input id="apply-snacks" type="checkbox" required class="accent-accent mt-1.5 size-4" />
      <label for="apply-snacks">I confirm I am comfortable working near snacks.</label>
    </div>
    <button type="submit" class="bg-accent text-paper rounded px-5 py-3 font-medium hover:opacity-90">
      Submit application
    </button>
  </form>

  <div
    data-apply-status
    role="status"
    tabindex="-1"
    class="border-rule bg-paper-2 hidden max-w-xl rounded-lg border p-6 outline-none"
  >
    <p class="font-serif text-2xl font-semibold">Application received.</p>
    <p class="mt-3 text-lg">Current position in queue: <span class="font-mono">321</span>.</p>
    <p class="text-muted mt-2">The hiring pug will review your scent shortly.</p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-apply]');
  const form = root?.querySelector<HTMLFormElement>('[data-apply-form]');
  const status = root?.querySelector<HTMLElement>('[data-apply-status]');
  const role = root?.querySelector<HTMLSelectElement>('#apply-role');

  // Preselect the role from the Apply button that brought the visitor here.
  const wanted = new URLSearchParams(window.location.search).get('role');
  if (role && wanted && [...role.options].some((o) => o.value === wanted)) role.value = wanted;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    form.hidden = true;
    status?.classList.remove('hidden');
    // The button that had focus just disappeared; move focus to the confirmation.
    status?.focus();
  });
</script>
