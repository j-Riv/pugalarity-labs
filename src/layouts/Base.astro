---
// Frontmatter (between the --- fences) runs at build time only, never in the browser.
// `Astro.props` is how a page passes values into this layout, like React props.
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/brand/pugalarity-labs-logo.png';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
}

const tagline = 'Artificial Intelligence, Questionable Intelligence';
const { title, description = `${tagline}. Aligning the future with snacks.` } = Astro.props;
// The home page passes the company name as its title and gets the tagline; other pages
// get "[Page] | Pugalarity Labs".
const fullTitle =
  title === 'Pugalarity Labs' ? `Pugalarity Labs | ${tagline}` : `${title} | Pugalarity Labs`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Social crawlers need an absolute image URL and a raster format (they ignore SVG).
const ogImage = new URL('/og-image.png', Astro.site);

const nav = [
  { href: '/research/', label: 'Research' },
  { href: '/models/snort-1/', label: 'Snort-1' },
  { href: '/safety/', label: 'Safety' },
  { href: '/team/', label: 'Team' },
  { href: '/careers/', label: 'Careers' },
  { href: '/news/series-z/', label: 'News' },
];

const footerLinks = [
  { href: '/playground/', label: 'Playground' },
  { href: '/legal/terms/', label: 'Terms' },
  { href: '/legal/privacy/', label: 'Privacy' },
  { href: '/legal/responsible-scaling-policy/', label: 'Responsible Scaling Policy' },
  { href: '/status/', label: 'Status: all systems napping' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark light" />
    <!-- Sets the theme before first paint so there is no flash. Dark is the default; only a
         saved "light" choice (from the toggle) overrides it. -->
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pugalarity Labs" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Pugalarity Labs: Aligning the future with snacks. A smiling pug in round glasses and a black turtleneck, standing in a spotlight." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-accent text-paper absolute left-4 top-2 z-50 -translate-y-20 rounded px-4 py-2 font-medium focus:translate-y-0"
    >
      Skip to content
    </a>

    <header class="border-rule border-b">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
        <a href="/" class="block shrink-0">
          <Image src={logo} alt="Pugalarity Labs" width={600} loading="eager" class="h-12 w-auto sm:h-14" />
        </a>
        <nav aria-label="Main" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
                class="text-muted hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline underline-offset-4"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="/waitlist/"
            class="bg-accent text-paper rounded px-3 py-1.5 font-medium hover:opacity-90"
          >
            Join waitlist
          </a>
          <button
            type="button"
            data-theme-toggle
            aria-pressed="true"
            aria-label="Dark mode"
            class="border-rule text-muted hover:text-ink inline-flex h-9 w-9 items-center justify-center rounded border"
          >
            <svg
              viewBox="0 0 24 24"
              class="hidden h-5 w-5 dark:block"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
            </svg>
            <svg
              viewBox="0 0 24 24"
              class="block h-5 w-5 dark:hidden"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-4 py-12 outline-none">
      <slot />
    </main>

    <footer class="border-rule border-t">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm">
        <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
          {
            footerLinks.map((item) => (
              <a href={item.href} class="text-muted hover:text-ink underline underline-offset-4">
                {item.label}
              </a>
            ))
          }
        </nav>
        <p class="text-muted mt-4">{tagline}</p>
        <p class="text-muted mt-1">© 2026 Pugalarity Labs, a Public Benefit Snorporation.</p>
      </div>
    </footer>

    <CookieBanner />

    <script>
      // The saved choice and the initial data-theme are handled by the inline script in <head>.
      // The toggle's pressed state means "dark mode is on".
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const sync = () => toggle?.setAttribute('aria-pressed', String(root.dataset.theme !== 'light'));
      sync();
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Storage can be blocked; the choice then lasts until the page is closed.
        }
        sync();
      });
    </script>
  </body>
</html>
