---
// Frontmatter (between the --- fences) runs at build time only, never in the browser.
// `Astro.props` is how a page passes values into this layout, like React props.
import '../styles/global.css';
import { Image } from 'astro:assets';
import ThemeToggle from '../components/ThemeToggle.astro';
import logo from '../assets/brand/pugalarity-labs-logo.png';
import logoLight from '../assets/brand/pugalarity-labs-logo-light.png';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
}

const tagline = 'Artificial Intelligence, Questionable Intelligence';
const { title, description = `${tagline}. Aligning the future with snacks.` } = Astro.props;
// The home page passes the company name as its title and gets the tagline; other pages
// get "[Page] | Pugalarity Labs".
const fullTitle =
  title === 'Pugalarity Labs' ? `Pugalarity Labs | ${tagline}` : `${title} | Pugalarity Labs`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Social crawlers need an absolute image URL and a raster format (they ignore SVG).
const ogImage = new URL('/og-image.png', Astro.site);

const nav = [
  { href: '/research/', label: 'Research' },
  { href: '/models/snort-1/', label: 'Snort-1' },
  { href: '/safety/', label: 'Safety' },
  { href: '/team/', label: 'Team' },
  { href: '/careers/', label: 'Careers' },
  { href: '/news/series-z/', label: 'News' },
];

const footerLinks = [
  { href: '/playground/', label: 'Playground' },
  { href: '/legal/terms/', label: 'Terms' },
  { href: '/legal/privacy/', label: 'Privacy' },
  { href: '/legal/responsible-scaling-policy/', label: 'Responsible Scaling Policy' },
  { href: '/status/', label: 'Status: all systems napping' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark light" />
    <!-- Sets the theme before first paint so there is no flash. Dark is the default; only a
         saved "light" choice (from the toggle) overrides it. -->
    <script is:inline>
      document.documentElement.dataset.js = '';
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pugalarity Labs" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Pugalarity Labs: Aligning the future with snacks. A smiling pug in round glasses and a black turtleneck, standing in a spotlight." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-accent text-paper absolute left-4 top-2 z-50 -translate-y-20 rounded px-4 py-2 font-medium focus:translate-y-0"
    >
      Skip to content
    </a>

    <header class="border-rule border-b">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-3 gap-y-3 px-4 py-4 lg:gap-x-5">
        <a href="/" class="order-1 mr-auto block shrink-0">
          <Image src={logo} alt="Pugalarity Labs" width={600} loading="eager" class="hidden h-12 w-auto sm:h-14 dark:block" />
          <Image src={logoLight} alt="Pugalarity Labs" width={600} loading="eager" class="block h-12 w-auto sm:h-14 dark:hidden" />
        </a>
        <div
          id="site-menu"
          data-menu
          class="order-3 w-full lg:order-2 lg:w-auto"
        >
          <nav
            aria-label="Main"
            class="flex flex-col text-base lg:flex-row lg:flex-wrap lg:items-center lg:gap-x-5 lg:text-sm"
          >
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={path.startsWith(item.href) ? 'page' : undefined}
                  class="text-muted hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline border-rule border-t py-3 underline-offset-4 lg:border-t-0 lg:py-0"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <div class="border-rule text-muted flex items-center justify-between border-t py-3 text-base lg:hidden">
            <span>Theme</span>
            <ThemeToggle class="inline-flex" />
          </div>
        </div>
        <div class="order-2 flex items-center gap-3 text-sm lg:order-3">
          <a
            href="/waitlist/"
            class="bg-accent text-paper rounded px-3 py-1.5 font-medium hover:opacity-90"
          >
            Join waitlist
          </a>
          <ThemeToggle class="hidden lg:inline-flex" />
          <button
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label="Menu"
            class="group border-rule text-muted hover:text-ink inline-flex h-9 w-9 items-center justify-center rounded border lg:hidden"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5 group-aria-expanded:hidden"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              viewBox="0 0 24 24"
              class="hidden h-5 w-5 group-aria-expanded:block"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-4 py-12 outline-none">
      <slot />
    </main>

    <footer class="border-rule border-t">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm">
        <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
          {
            footerLinks.map((item) => (
              <a href={item.href} class="text-muted hover:text-ink underline underline-offset-4">
                {item.label}
              </a>
            ))
          }
        </nav>
        <p class="text-muted mt-4">{tagline}</p>
        <p class="text-muted mt-1">© 2026 Pugalarity Labs, a Public Benefit Snorporation.</p>
      </div>
    </footer>

    <CookieBanner />

    <!-- Cloudflare Web Analytics: cookieless page-view counts. Keep this the only beacon on the page. -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "d68075d26d5d42c895aba54279a0df1a"}'></script>

    <script>
      // The saved choice and the initial data-theme are handled by the inline script in <head>.
      // A toggle's pressed state means "dark mode is on". The header has two (desktop and menu).
      const root = document.documentElement;
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      const sync = () =>
        toggles.forEach((t) => t.setAttribute('aria-pressed', String(root.dataset.theme !== 'light')));
      sync();
      toggles.forEach((toggle) =>
        toggle.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {
            // Storage can be blocked; the choice then lasts until the page is closed.
          }
          sync();
        }),
      );

      // Below lg the nav lives in a dropdown panel that this button opens.
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const setMenu = (open: boolean) => {
        menu?.toggleAttribute('data-open', open);
        menuButton?.setAttribute('aria-expanded', String(open));
      };
      menuButton?.addEventListener('click', () => setMenu(!menu?.hasAttribute('data-open')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.hasAttribute('data-open')) {
          setMenu(false);
          menuButton?.focus();
        }
      });
      window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false);
      });
    </script>
  </body>
</html>
