---
// Nested folders become nested URLs: src/pages/models/snort-1.astro -> /models/snort-1/
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import BarChart from '../../components/BarChart.astro';
import LineChart from '../../components/LineChart.astro';
import { benchmarkSeries, benchmarks, scalingPoints } from '../../data/benchmarks';
import { models } from '../../data/snort';

const specs = [
  ['Release', 'Private preview, Q3 2026'],
  ['Context window', '128k sniffs'],
  ['Parameters', '11 billion wrinkles'],
  ['Modalities', 'Sniff, bark, head tilt'],
  ['Training data', '40 petabelly-rubs'],
];

const card = [
  ['Intended use', 'Being held. Secondary uses include lap occupancy and floor-based reasoning.'],
  ['Out-of-scope use', 'Agentic mailman interception. Stair navigation.'],
  ['Training', 'Pretrained on 40 petabelly-rubs, then tuned with reinforcement learning from treat feedback (RLTF).'],
  ['Known limitations', 'Stairs. Performance degrades in the vicinity of open windows and vacuum cleaners.'],
  ['Evaluation', 'All results were produced by Snort-1 under supervised conditions (a blanket).'],
];
---

<Base
  title="Snort-1"
  description="Snort-1 is Pugalarity Labs' flagship model: 11 billion wrinkles, a 128k sniff context window, and state-of-the-art results on five benchmarks."
>
  <PageHeader
    eyebrow="Flagship model"
    title="Snort-1"
    lead="Our most capable model to date. Snort-1 is trained to be helpful, harmless, and horizontal."
  />

  <section aria-labelledby="specs-heading">
    <h2 id="specs-heading" class="text-3xl font-semibold">Overview</h2>
    <dl class="border-rule mt-6 divide-y divide-rule border-y">
      {
        specs.map(([k, v]) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[12rem_1fr] sm:gap-6">
            <dt class="text-muted">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="models-heading" class="mt-20">
    <h2 id="models-heading" class="text-3xl font-semibold">Models</h2>
    <p class="text-muted mt-3 max-w-2xl text-lg">
      Snort-1 is available in three sizes. Pricing is per million treats.
    </p>
    <ul class="mt-6 grid gap-6 sm:grid-cols-3">
      {
        models.map((m) => (
          <li class="border-rule bg-paper-2 hover:border-accent relative flex flex-col rounded-lg border p-5">
            <h3 class="font-serif text-xl font-semibold">{m.label}</h3>
            <p class="text-muted mt-1 grow">{m.tagline}</p>
            <dl class="border-rule divide-rule mt-4 divide-y border-y text-sm">
              <div class="flex justify-between gap-4 py-2">
                <dt class="text-muted">Context</dt>
                <dd class="text-right">{m.context}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2">
                <dt class="text-muted">Input</dt>
                <dd class="text-right">{m.price.input}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2">
                <dt class="text-muted">Output</dt>
                <dd class="text-right">{m.price.output}</dd>
              </div>
              <div class="flex justify-between gap-4 py-2">
                <dt class="text-muted">Limitation</dt>
                <dd class="text-right">{m.limitation}</dd>
              </div>
            </dl>
            <a
              href={`/playground/?model=${m.id}`}
              class="pt-4 underline underline-offset-4 after:absolute after:inset-0 after:content-['']"
              aria-label={`Try ${m.label} in the playground`}
            >
              Try in the playground
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="bench-heading" class="mt-20">
    <h2 id="bench-heading" class="text-3xl font-semibold">Benchmarks</h2>
    <p class="text-muted mt-3 max-w-2xl">
      Snort-1 sets a new state of the art on four of five evaluations. We continue to investigate
      the fifth.
    </p>
    <div class="mt-6">
      <BarChart
        title="Snort-1 versus prior systems"
        caption="Higher is better. Scores in percent."
        series={benchmarkSeries}
        groups={benchmarks}
      />
    </div>
  </section>

  <section aria-labelledby="scaling-heading" class="mt-20">
    <h2 id="scaling-heading" class="text-3xl font-semibold">Scaling</h2>
    <p class="text-muted mt-3 max-w-2xl">
      Performance improves predictably with training treats. New capabilities emerge at specific
      thresholds, the first of which we have observed at roughly 40 treats.
    </p>
    <div class="mt-6 max-w-2xl">
      <LineChart
        title="Loss as a function of training treats"
        desc="Line chart on a log scale. Loss falls from 2.8 at 1 treat to 0.35 at 10,000 treats. Rolling over emerges at about 40 treats."
        xLabel="Training treats (log scale)"
        yLabel="Loss"
        xTicks={[1, 10, 100, 1000, 10000]}
        yTicks={[0, 1, 2, 3]}
        points={scalingPoints}
        annotation={{ x: 40, text: 'Rolling over emerges' }}
      />
    </div>
  </section>

  <section aria-labelledby="card-heading" class="mt-20">
    <h2 id="card-heading" class="text-3xl font-semibold">Model card</h2>
    <dl class="border-rule mt-6 divide-y divide-rule border-y">
      {
        card.map(([k, v]) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[12rem_1fr] sm:gap-6">
            <dt class="text-muted">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/waitlist/" class="bg-accent text-paper inline-block rounded px-5 py-3 font-medium hover:opacity-90">
        Request early access
      </a>
      <a href="/playground/" class="underline underline-offset-4">Try Snort-1 in the playground</a>
    </p>
  </section>
</Base>
