---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const DAYS = 90;
// Day index 62 is 27 days before today (October 30, 2026): the October 3 incident.
const INCIDENT_DAY = 62;

const components = [
  { name: 'Snort-1 inference', uptime: '99.99%', incident: false },
  { name: 'Playground', uptime: '99.99%', incident: false },
  { name: 'Waitlist', uptime: '100%', incident: false },
  { name: 'Snack delivery pipeline', uptime: '99.98%', incident: false },
  { name: 'Couch cluster (us-couch-1)', uptime: '99.97%', incident: true },
  { name: 'Mailman detection', uptime: '100%', incident: false },
];

const bars = Array.from({ length: DAYS }, (_, i) => i);

const timeline = [
  ['2:14 p.m.', 'Investigating', 'We are investigating reports of elevated snoring in us-couch-1.'],
  ['2:40 p.m.', 'Monitoring', 'Snoring has been traced to a single cushion. Impact is limited to nearby couches.'],
  ['3:05 p.m.', 'Resolved', 'The cushion was repositioned. Snoring has returned to baseline.'],
];
---

<Base
  title="Status"
  description="Current and historical status of Pugalarity Labs services. All systems napping."
>
  <PageHeader eyebrow="Status" title="All systems napping." lead="Every service is operating as expected." />

  <section aria-labelledby="components-heading">
    <h2 id="components-heading" class="text-3xl font-semibold">Services</h2>
    <ul class="divide-rule border-rule mt-6 divide-y border-y">
      {
        components.map((c) => (
          <li class="py-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-lg font-semibold">{c.name}</h3>
              <p class="text-accent font-medium">Napping (expected)</p>
            </div>
            <div class="mt-3 flex h-8 gap-px" aria-hidden="true">
              {
                bars.map((i) => (
                  <span
                    class={`min-w-0 flex-1 rounded-[1px] ${c.incident && i === INCIDENT_DAY ? 'bg-muted' : 'bg-accent'}`}
                  />
                ))
              }
            </div>
            <div class="text-muted mt-2 flex justify-between text-sm">
              <span>90 days ago</span>
              <span>{c.uptime} uptime</span>
              <span>Today</span>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="text-muted mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <span class="flex items-center gap-2"><span class="bg-accent inline-block h-3 w-3 rounded-sm" aria-hidden="true"></span>Napping (expected)</span>
      <span class="flex items-center gap-2"><span class="bg-muted inline-block h-3 w-3 rounded-sm" aria-hidden="true"></span>Elevated snoring</span>
    </p>
  </section>

  <section aria-labelledby="incidents-heading" class="border-rule mt-20 max-w-3xl border-t pt-12">
    <h2 id="incidents-heading" class="text-3xl font-semibold">Incident history</h2>
    <article class="mt-6">
      <h3 class="text-xl font-semibold">Elevated snoring in us-couch-1</h3>
      <p class="text-muted mt-1 font-mono text-sm">
        <time datetime="2026-10-03">October 3, 2026</time> · Resolved
      </p>
      <ol class="border-rule mt-5 space-y-4 border-l pl-5">
        {
          timeline.map(([time, state, text]) => (
            <li>
              <p class="font-medium">
                {state} <span class="text-muted font-mono text-sm font-normal">· {time}</span>
              </p>
              <p class="mt-1">{text}</p>
            </li>
          ))
        }
      </ol>
    </article>
  </section>
</Base>
