---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { roles, benefits } from '../data/roles';
---

<Base
  title="Careers"
  description="Join Pugalarity Labs. We are hiring across alignment, research, infrastructure, and safety."
>
  <PageHeader
    eyebrow="Careers"
    title="Help us build what comes next."
    lead="We are looking for exceptional people to join a small, fast-moving team working on the most important problem of our time, which is dinner."
  />

  <section aria-labelledby="roles-heading">
    <h2 id="roles-heading" class="text-3xl font-semibold">Open roles</h2>
    <ul class="mt-6 space-y-6">
      {
        roles.map((r) => (
          <li>
            <article class="border-rule bg-paper-2 rounded-lg border p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-xl font-semibold">{r.title}</h3>
                <p class="text-muted font-mono text-sm">
                  {r.team} · {r.location}
                </p>
              </div>
              <p class="mt-3 max-w-3xl">{r.summary}</p>
              <p class="mt-4 font-medium">You might be a fit if you have:</p>
              <ul class="text-muted mt-1 list-disc space-y-1 pl-5">
                {r.requirements.map((q) => <li>{q}</li>)}
              </ul>
              <a
                href="/waitlist/"
                class="bg-accent text-paper mt-5 inline-block rounded px-4 py-2 font-medium hover:opacity-90"
              >
                Apply<span class="sr-only"> for {r.title}</span>
              </a>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="benefits-heading" class="border-rule mt-20 border-t pt-12">
    <h2 id="benefits-heading" class="text-3xl font-semibold">Benefits</h2>
    <dl class="mt-6 grid gap-x-10 gap-y-6 md:grid-cols-2">
      {
        benefits.map(([k, v]) => (
          <div>
            <dt class="font-semibold">{k}</dt>
            <dd class="text-muted mt-1">{v}</dd>
          </div>
        ))
      }
    </dl>
    <p class="text-muted mt-10 max-w-2xl text-sm">
      Pugalarity Labs is an equal opportunity employer. We do not discriminate on the basis of
      coat color, wrinkle density, or snort frequency.
    </p>
  </section>
</Base>
