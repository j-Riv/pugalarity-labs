---
import Legal from '../../layouts/Legal.astro';

const sections = [
  {
    heading: '1. Acceptance of terms',
    body: 'By reading this sentence you agree to give the dog the rest of your sandwich. Continued use of this website constitutes acceptance of these Terms and of the sandwich arrangement.',
  },
  {
    heading: '2. Use of the service',
    body: 'Snort-1 and related services may be used for lawful purposes, including being held. You agree not to ask Snort-1 to open the pantry, operate a doorknob, or evaluate the mailman.',
  },
  {
    heading: '3. Intellectual property',
    body: 'All content on this website is owned by Pugalarity Labs or, where applicable, was already on the floor. You may not reproduce our content without permission, which we will grant by sitting on it.',
  },
  {
    heading: '4. Disclaimer of warranties',
    body: 'The service is provided “as is,” without warranty of any kind, including merchantability, fitness for a particular purpose, or that it will come when called.',
  },
  {
    heading: '5. Limitation of liability',
    body: 'Pugalarity Labs is not liable for hair on clothing, drool on devices, or damage to sofas. Our total liability to you will not exceed one (1) treat.',
  },
  {
    heading: '6. Governing law and disputes',
    body: 'These Terms are governed by the laws of Couch Valley. Disputes will be resolved by binding nap.',
  },
  {
    heading: '7. Changes to these terms',
    body: 'We may update these Terms at any time. Notice of material changes will be provided by a single, quiet bark.',
  },
];
---

<Legal
  title="Terms of Service"
  description="The terms governing your use of the Pugalarity Labs website and services."
>
  {
    sections.map((s) => (
      <section>
        <h2 class="text-2xl font-semibold">{s.heading}</h2>
        <p class="mt-3">{s.body}</p>
      </section>
    ))
  }
  <section>
    <h2 class="text-2xl font-semibold">Contact</h2>
    <p class="mt-3">Questions about these Terms may be directed to our legal department. Please bark.</p>
  </section>
</Legal>
