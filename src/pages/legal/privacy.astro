---
import Legal from '../../layouts/Legal.astro';

const sections = [
  {
    heading: 'What we collect',
    body: 'Almost nothing. This website uses cookieless, privacy-preserving analytics that count page views. They do not collect personal data or track individuals, and we have yet to find a pug in the numbers. There are no accounts and no database. The waitlist form does not transmit your email address anywhere, and we have not found a place to put it.',
  },
  {
    heading: 'Cookies',
    body: 'We do not set cookies. The analytics do not either. We have already eaten them.',
  },
  {
    heading: 'How we use information',
    body: 'We hold no personal information about you, so we do not use any. Page-view counts are used to confirm that someone is reading this page. We recognize this limits our personalization roadmap.',
  },
  {
    heading: 'Sharing',
    body: 'We do not share your personal information with third parties. We have none to share, and the third parties have not asked. Our analytics provider counts page views on our behalf, and has not asked for anything else.',
  },
  {
    heading: 'Your rights',
    body: 'You may request access to, correction of, or deletion of any personal data we hold about you. We hold none. Requests will be acknowledged with a tilted head.',
  },
  {
    heading: 'Children',
    body: 'Our services are intended for adults and for pugs of any age.',
  },
];
---

<Legal
  title="Privacy Policy"
  description="Pugalarity Labs collects almost nothing. We are pugs."
  lead="We collect almost nothing. We are pugs."
>
  {
    sections.map((s) => (
      <section>
        <h2 class="text-2xl font-semibold">{s.heading}</h2>
        <p class="mt-3">{s.body}</p>
      </section>
    ))
  }
</Legal>
