---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonCard from '../components/PersonCard.astro';
import { executives } from '../data/team';
import { board } from '../data/board';
---

<Base
  title="Team"
  description="Meet the executive team and Board of Directors at Pugalarity Labs: six pugs, one German shepherd, one very enthusiastic mixed-breed, and a board that includes a plush llama, collectively responsible for the future."
>
  <PageHeader
    eyebrow="Team"
    title="Leadership"
    lead="Our executives bring decades of combined experience in sitting, staring, and being carried."
  />

  <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      executives.map((e) => (
        <li>
          <PersonCard {...e} />
        </li>
      ))
    }
  </ul>

  <section aria-labelledby="board-heading" class="border-rule mt-20 border-t pt-12">
    <h2 id="board-heading" class="text-3xl font-semibold">Board of Directors</h2>
    <p class="text-muted mt-3 max-w-2xl text-lg">
      The Board meets quarterly, or whenever someone opens a bag.
    </p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        board.map((m) => (
          <li>
            <PersonCard {...m} level="h3" compact />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
