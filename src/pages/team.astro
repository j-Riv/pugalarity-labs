---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Pug from '../components/Pug.astro';
import { executives } from '../data/team';
---

<Base
  title="Team"
  description="Meet the executive team at Pugalarity Labs: six pugs and one cushion, collectively responsible for the future."
>
  <PageHeader
    eyebrow="Team"
    title="Leadership"
    lead="Our executives bring decades of combined experience in sitting, staring, and being carried."
  />

  <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      executives.map((e) => (
        <li>
          <article class="border-rule bg-paper-2 h-full rounded-lg border p-5">
            <Pug
              class="w-full"
              coat={e.coat}
              expression={e.expression}
              accessories={e.accessories}
              alt={e.alt}
            />
            <h2 class="mt-5 text-xl font-semibold">{e.name}</h2>
            <p class="text-accent mt-1 font-medium">{e.title}</p>
            <p class="text-muted mt-3">{e.bio}</p>
          </article>
        </li>
      ))
    }
  </ul>

  <section aria-labelledby="board-heading" class="border-rule mt-20 border-t pt-12">
    <h2 id="board-heading" class="text-3xl font-semibold">Board of Directors</h2>
    <div class="mt-6 flex flex-col items-start gap-6 sm:flex-row sm:items-center">
      <svg
        viewBox="0 0 160 120"
        class="w-40 shrink-0"
        role="img"
        aria-label="Illustration of a plush square cushion with a single center button."
        xmlns="http://www.w3.org/2000/svg"
        focusable="false"
      >
        <rect width="160" height="120" rx="16" fill="var(--paper-2)"></rect>
        <path
          d="M24 30 Q80 14 136 30 Q146 60 136 90 Q80 106 24 90 Q14 60 24 30 Z"
          fill="#a35514"
          stroke="#7a3d0d"
          stroke-width="3"
          stroke-linejoin="round"></path>
        <g stroke="#7a3d0d" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.7">
          <path d="M80 60 L40 34"></path>
          <path d="M80 60 L120 34"></path>
          <path d="M80 60 L40 86"></path>
          <path d="M80 60 L120 86"></path>
        </g>
        <circle cx="80" cy="60" r="7" fill="#e8a863" stroke="#7a3d0d" stroke-width="2.5"></circle>
      </svg>
      <div class="max-w-xl">
        <p class="text-lg">
          The Board consists of one (1) cushion, which has served continuously since founding.
        </p>
        <p class="text-muted mt-2">
          The cushion has never voted against management and has never been observed to move.
        </p>
      </div>
    </div>
  </section>
</Base>
